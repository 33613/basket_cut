# Optional deployment settings. Copy to .env and keep it outside Git.
# Relative resource paths are resolved from the working directory.
BASKET_RUNTIME_ROOT=./runtime
# Set these to executables in separately installed model environments.
# BASKET_MOTIP_PYTHON=/path/to/tracking-env/bin/python
# BASKET_KPR_PYTHON=/path/to/identity-env/bin/python
# BASKET_ACTION_PYTHON=/path/to/action-env/bin/python
# BASKET_REVIEW_PYTHON=/path/to/opencv-env/bin/python
# BASKET_OCR_PYTHON=/path/to/ocr-env/bin/python
# BASKET_OCR_MODEL_DIR=./runtime/models/ocr/easyocr
# BASKET_MOTIP_CHECKPOINT=./runtime/models/motip/r50_deformable_detr_motip_sportsmot.pth
# BASKET_KPR_CHECKPOINT=./runtime/models/kpr/kpr_dancetrack_sportsmot_posetrack21_occludedduke_market_split0.pth.tar
# BASKET_ACTION_CHECKPOINT=./runtime/models/action/slowfast_multisports.pth
# Existing layouts can be imported without relocating inputs or results:
# BASKET_WEB_SOURCE_ROOT=/path/to/data
# BASKET_WEB_IMPORT_ROOT=/path/to/results
# BASKET_WEB_OUTPUT_ROOT=/path/to/dashboard-index
# BASKET_WEB_DATA_ROOT=/path/to/dashboard-inputs
